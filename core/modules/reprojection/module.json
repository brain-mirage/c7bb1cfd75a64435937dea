{
  "id": "reprojection",
  "name": "Reprojection",
  "kind": "render",
  "version": "0.1.0",
  "contract": 4,
  "assembly": "reprojection.dll",
  "entry": "TK.Modules.Reprojection.Module",
  "bundle": "reprojection.bundle",
  "modes": "3d=3D;3d-sphere=3D-Sphere",
  "options": [
    { "key": "3d-tracking", "name": "Camera Tracks the Character", "type": "toggle", "default": "true", "modes": [ "3d", "3d-sphere" ] },
    { "key": "3d-mouse-orbit", "name": "Rotate Camera with the Mouse", "type": "toggle", "default": "true", "modes": [ "3d", "3d-sphere" ] },
    { "key": "3d-turn-figures", "name": "Frames Follow Camera", "type": "toggle", "default": "false", "modes": [ "3d", "3d-sphere" ], "desc": "Your character shows the facing seen by the camera and turns toward it." },
    { "key": "3d-turn-others", "name": "Other Figures Turn With Camera", "type": "toggle", "default": "true", "modes": [ "3d", "3d-sphere" ], "desc": "Monsters, NPCs and other players show the side the camera sees." },
    { "key": "3d-forward-facing", "name": "Forward Follows Facing", "type": "toggle", "default": "false", "modes": [ "3d", "3d-sphere" ], "desc": "Forward walks the way you face; other movement keys follow from it." },
    { "key": "3d-tilt", "name": "Tilt", "type": "range", "min": 0, "max": 175, "step": 5, "default": "55", "modes": [ "3d", "3d-sphere" ] },
    { "key": "3d-fov", "name": "Field of View", "type": "range", "min": 5, "max": 90, "step": 5, "default": "30", "modes": [ "3d", "3d-sphere" ] },
    { "key": "3d-orbit", "name": "Orbit (degrees)", "type": "range", "min": 0, "max": 345, "step": 15, "default": "0", "modes": [ "3d", "3d-sphere" ] },
    { "key": "3d-zoom", "name": "Zoom (%)", "type": "range", "min": 20, "max": 400, "step": 10, "default": "100", "modes": [ "3d", "3d-sphere" ] },
    { "key": "3d-blocks", "name": "Blocked Tiles as Blocks", "type": "toggle", "default": "true", "modes": [ "3d", "3d-sphere" ] },
    { "key": "3d-depth", "name": "Thin Solids' Depth", "values": "thin=Thin (6 px);half=Half a Cell;full=A Full Cell", "modes": [ "3d", "3d-sphere" ] },
    { "key": "3d-sides", "name": "Block Sides", "values": "mirrored=Mirrored from the Picture;edge=Edge Pixels Carried Round", "modes": [ "3d", "3d-sphere" ] },
    { "key": "3d-trees", "name": "Trees", "values": "turning=Turning Card;crossed=Crossed Cards;revolved=Revolved;boxed=Boxed (4 Copies);thin=Thin Solid", "modes": [ "3d", "3d-sphere" ] },
    { "key": "3d-statues", "name": "Statues and Posts", "values": "revolved=Revolved;boxed=Boxed (4 Copies);thin=Thin Solid;crossed=Crossed Cards", "modes": [ "3d", "3d-sphere" ] },
    { "key": "3d-character", "name": "Figures", "values": "card=Flat Card;thin=Thin Solid", "modes": [ "3d", "3d-sphere" ] },
    { "key": "3d-shadows", "name": "Shadows", "values": "cast=Cast by the Sun;painted=Painted on the Ground", "modes": [ "3d", "3d-sphere" ] },
    { "key": "3d-sphere-radius", "name": "Sphere Radius (cells)", "type": "range", "min": 20, "max": 1000, "step": 10, "default": "60", "modes": [ "3d-sphere" ] },
    { "key": "3d-view-distance", "name": "View Distance", "type": "viewdistance", "min": 0, "max": 1000, "step": 10, "default": "500,650", "modes": [ "3d", "3d-sphere" ], "page": "graphics", "needs": "3d-fade-out", "desc": "Controls the view distance in 3D modes." },
    { "key": "3d-fade-out", "name": "Fade Out", "type": "toggle", "default": "true", "modes": [ "3d", "3d-sphere" ], "page": "graphics", "desc": "Makes tiles fade out this far past the view distance." },
    { "key": "3d-sky", "name": "Sky", "type": "toggle", "default": "true", "modes": [ "3d", "3d-sphere" ], "page": "skybox" },
    { "key": "3d-horizon", "name": "Horizon From the Map (%)", "type": "range", "min": 0, "max": 100, "step": 10, "default": "100", "modes": [ "3d", "3d-sphere" ], "page": "skybox", "needs": "3d-sky" },
    { "key": "3d-ground-grid", "name": "Ground Grid Past the Map", "type": "toggle", "default": "true", "modes": [ "3d", "3d-sphere" ], "page": "skybox" }
  ],
  "actions": [
    { "id": "mode.3d", "name": "Reprojection: 3D" },
    { "id": "mode.3d-sphere", "name": "Reprojection: 3D-Sphere" },
    { "id": "mode.normal", "name": "Reprojection: Back to Normal" },
    { "id": "tilt.up", "name": "Reprojection: 3D Tilt Up" },
    { "id": "tilt.down", "name": "Reprojection: 3D Tilt Down" },
    { "id": "fov.up", "name": "Reprojection: 3D Wider Field of View" },
    { "id": "fov.down", "name": "Reprojection: 3D Narrower Field of View" },
    { "id": "camera.reset", "name": "Reprojection: 3D Default View" },
    { "id": "camera.tracking", "name": "Reprojection: 3D Camera Tracking or Fixed" },
    { "id": "orbit.left", "name": "Reprojection: 3D Orbit Left" },
    { "id": "orbit.right", "name": "Reprojection: 3D Orbit Right" },
    { "id": "zoom.in", "name": "Reprojection: 3D Zoom In" },
    { "id": "zoom.out", "name": "Reprojection: 3D Zoom Out" },
    { "id": "pan.left", "name": "Reprojection: 3D Pan Left" },
    { "id": "pan.right", "name": "Reprojection: 3D Pan Right" },
    { "id": "pan.up", "name": "Reprojection: 3D Pan Away" },
    { "id": "pan.down", "name": "Reprojection: 3D Pan Toward" },
    { "id": "blocks.next", "name": "Reprojection: 3D Blocked Tiles" },
    { "id": "depth.next", "name": "Reprojection: 3D Next Thin Depth" },
    { "id": "sides.next", "name": "Reprojection: 3D Next Block Sides" },
    { "id": "trees.next", "name": "Reprojection: 3D Next Trees" },
    { "id": "statues.next", "name": "Reprojection: 3D Next Statues" },
    { "id": "character.next", "name": "Reprojection: 3D Next Figures" },
    { "id": "shadows.next", "name": "Reprojection: 3D Next Shadows" }
  ]
}
