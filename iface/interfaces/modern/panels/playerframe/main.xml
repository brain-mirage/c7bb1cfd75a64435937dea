<?xml version="1.0" encoding="utf-8"?>
<!-- Modern's player frame (its XML twin's layout; main.lua fills it, lays it out by the page's settings and shows a hovered
     spell's cost): the portrait with its level badge, the name and path, the health, mana and experience bars. Format:
     core/xml.md. Drawing only. -->
<ui>
  <!-- the portrait's size and the bars' heights (s6-ui-core round 82, the owner: the health and mana bars a little taller,
       filling the room the experience bar left when it moved under the portrait); main.lua's Layout places by them -->
  <data key="SIZES" portrait="56" hp="19" mp="14" xp="7"/>

  <frame name="TKPlayerFrame" key="frame" parent="UIParent">
    <backdrop bg="0.04, 0.04, 0.05, 0.85" edge="0.55, 0.55, 0.58, 1"/>
    <!-- s6-ui-settings (round 4): the shared panel style; s6-ui-core (round 53): or its own -->
    <run call="HudPanel"/>
    <!-- s6-characters seam (the owner, 2026-10-01): the character's portrait over the disc, under the ring (Modern's
         portrait.lua), and its level on a badge at its bottom right, over it -->
    <portrait key="portrait" size="@SIZES.portrait" point="TOPLEFT" x="8" y="-8" colour="0.25, 0.35, 0.8">
      <frame key="badge" Size="26, 18" Point="BOTTOMRIGHT, @parent, BOTTOMRIGHT, 6, -4">
        <backdrop bg="0.1, 0.08, 0.02, 0.95" edge="0.85, 0.75, 0.45, 1"/>
        <run call="OverPortrait"/>
        <label key="level" text="" size="11" colour="gold" Point="CENTER, @parent, CENTER, 0, 0"/>
      </frame>
    </portrait>

    <!-- the name in the original's own font -->
    <label key="name" text="" size="14" colour="white" justify="LEFT" Font="classic, 12, "/>
    <label key="path" text="" size="11" colour="0.7, 0.7, 0.75" justify="RIGHT"/>
    <bar key="hp" height="@SIZES.hp" colour="0.15, 0.75, 0.15" textsize="11"/>
    <bar key="mp" height="@SIZES.mp" colour="0.2, 0.45, 0.95" textsize="11">
      <!-- the mana-cost preview (plan 5.11): over the mana bar, yellow for the mana a hovered spell would use and red for
           the shortfall beyond the mana there is -->
      <texture key="costYellow" layer="OVERLAY" ColorTexture="1, 0.85, 0.15, 0.85" Hide=""/>
      <texture key="costRed" layer="OVERLAY" ColorTexture="0.95, 0.15, 0.1, 0.85" Hide=""/>
    </bar>
    <bar key="xp" height="@SIZES.xp" colour="0.6, 0.25, 0.85" textsize="11" EnableMouse="true">
      <run call="SmallText"/>
      <on script="OnEnter" call="XpTip"/>
      <on script="OnLeave" call="Untip"/>
    </bar>

    <do RegisterEvent="UNIT_HEALTH"/>
    <do RegisterEvent="UNIT_POWER"/>
    <do RegisterEvent="PLAYER_XP_UPDATE"/>
    <do RegisterEvent="UNIT_NAME_UPDATE"/>
    <do RegisterEvent="PLAYER_ENTERING_WORLD"/>
    <!-- s6-characters' (round 36): its pictures of the player changed -->
    <do RegisterEvent="UNIT_PORTRAIT_UPDATE"/>
    <run call="ProfilePicture"/>
    <on script="OnEvent" call="Changed"/>
    <do EnableMouse="true"/>
    <on script="OnEnter" call="Tip"/>
    <on script="OnLeave" call="Untip"/>
  </frame>
</ui>
