<?xml version="1.0" encoding="utf-8"?>
<!-- 7.x's look of the web board and the browser dialog (its XML twin's layout; web.lua draws with it), from Source-5's
     class pages. Format: core/xml.md; each dialog's attributes are its look entry's values (interfaces/original/entry.lua), its
     children its windows: the size, the button's place (its image's 63 x 24 from there) and the browser's area (left,
     top, right, bottom), where the page's text, its address and Open in browser go.
     WIRE: the button's rectangle is where a press on it lands (the close, the 73 request and the 62 page are the
     renderer's and the model's); changing it changes which control a press reaches. -->
<ui>
  <!-- The web board (WebBoardDialog 0x0046D050) by its mode: the board (0), a player's page (4: CLOSE inside the
       browser's area, as 4a's), mode 6; CLOSE is image 30 -->
  <data key="WebBoard" width="700" height="500" button="63" openButton="140" buttonHeight="24">
    <data key="modes">
      <mode mode="0" size="700, 500" close="318, 468" area="11, 42, 689, 460"/>
      <mode mode="4" size="418, 566" close="318, 468" area="11, 42, 407, 526"/>
      <mode mode="6" size="800, 600" close="368, 568" area="11, 42, 789, 560"/>
    </data>
    <data key="image" value="30"/>
  </data>

  <!-- The browser dialog (BrowserDialog 0x0046AA40): 662 x 562 for a server's page (4a's default: HandleOpenBrowserPacket
       passes 0 x 0), 900 x 650 for the help key's (UserPane::HandleKeyOrTextEvent); OK (image 14) at ((w - 63) / 2, h -
       32); the area (11, 42) w - 22 by h - 82 (ComputeControlRect): its right and bottom from the window's -->
  <data key="Browser" width="662" height="562" button="63" openButton="140" buttonHeight="24">
    <data key="help" value="900, 650"/>
    <data key="image" value="14"/>
    <data key="okUp" value="32"/>
    <data key="area" left="11" top="42" right="11" bottom="40"/>
  </data>

  <!-- in the browser's area: the page's text 10 in (its bottom 40 up), the address 50 down (12 high), Open in browser
       10 in from its bottom left -->
  <data key="AREA" inset="10" textBottom="40" address="50"/>
</ui>
