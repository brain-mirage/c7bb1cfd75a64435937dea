<!-- 7.x's look of the target options and the profile (its XML twin's layout; options.lua draws with it), 4a's
     ui/OptionPane.cpp from Source-5's class pages (the EPF layout). Format: core/xml.md; each dialog's attributes are
     its look entry's values (interfaces/original/entry.lua), its children where options.lua draws its parts: rectangles (left, top,
     right, bottom), pictures (file, palette) and image buttons (BUTT001.EPF's image id first).
     WIRE: a switch takes a press only on its 20 x 20 part (TargetOptionEditControlPane's GetPartRect 0x00499810,
     HitTestPoint 0x00499870); the switches choose what the arrow keys step through while a spell's target is picked, so
     which target a cast names: moving a part changes which press toggles one (options.lua's Target). -->
<ui>
  <!-- The target options (TargetOptionDialog 0x00542270): 338 x 190 on DLGSETUP.EPF in DLGSETUP.PAL, slot 3 (centred),
       sliding open; OK (1, image 14); the rows ARROW (2) and SHIFT+ARROW (3) (TargetOptionEditControlPane) at (19, 64 +
       34 i)-(318, 84 + 34 i), each drawn by its OnPaint (0x00499430: font 0 in 0x80, bold, on the row's line 14): its
       keys' name from x 18 (ARROW) or 0 (SHIFT+ARROW), "USER" from 130 and "MONSTER" from 220, and the two switches'
       ONOFFBUT.EPF pictures in BUTTON.PAL (frame 1 on, 0 off) on their parts, (110, 0)-(130, 20) and (200, 0)-(220,
       20). -->
  <data key="Target" width="338" height="190" button="63" switch="20" buttonHeight="20" slide="true">
    <data key="art" value="DLGSETUP.EPF, DLGSETUP.PAL"/>
    <data key="ok" value="14, 138, 156, 201, 180"/>
    <data key="rows" x="19" y="64" step="34" line="14"/>
    <data key="keys">
      <key text="ARROW" x="18"/>
      <key text="SHIFT+ARROW" x="0"/>
    </data>
    <data key="user" text="USER" x="130"/>
    <data key="monster" text="MONSTER" x="220"/>
    <data key="parts" value="110, 200"/>
    <data key="onoff" file="ONOFFBUT.EPF" palette="BUTTON.PAL"/>
  </data>

  <!-- The profile (ProfileDialog 0x0053F940): 285 x 238 on DLGPROFL.EPF in DLGPROFL.PAL, slot 12 (centred), sliding
       open; the text (1), an edit in 0x8F with its scroll bar at the right edge (wrapping at 145, round 2: 10 lines show
       of 16); OK (2, image 14). -->
  <data key="Profile" width="285" height="238" button="63" editWidth="157" editHeight="120" slide="true">
    <data key="art" value="DLGPROFL.EPF, DLGPROFL.PAL"/>
    <data key="edit" value="68, 54, 225, 174, 0x8F"/>
    <data key="ok" value="14, 108, 200, 171, 224"/>
  </data>
</ui>
