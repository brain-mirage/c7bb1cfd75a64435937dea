<?xml version="1.0" encoding="utf-8"?>
<!-- 7.x's map name (its XML twin's layout; main.lua draws the name): the original's MapNamePane (ui/MapNamePane.cpp) at
     (316, 0)-(509, 24) on the 7.x screen, in the frame layer over the map view (MainMenuPane::InitializeMainUiGraph).
     Format: core/xml.md. -->
<ui>
  <!-- its top left on the 7.x screen (Screen.PlacePanel follows the scaled screen until the player moves it) -->
  <data key="PLACE" value="316, 0"/>
  <!-- the name: cut to FitTextAndAppendSuffix's width (0xAD) with "...", centred on the plate in the skin's text colour
       (0x80), its pen 5 below the plate's middle (OnPaint 0x00503350) -->
  <data key="NAME" fit="173" baseline="17" colour="TEXT"/>

  <!-- the frame layer, over the map view. It is never mouse-enabled (main.lua's wire note): a press on it is the map's -->
  <frame name="TK7xMapName" key="frame" parent="UIParent" FrameStrata="LOW" FrameLevel="10" Size="193, 24">
    <!-- the plate: MAPNAME.EPF frame 0 in FRMPART.PAL -->
    <picture key="plate" file="MAPNAME.EPF" frame="0" palette="FRMPART.PAL" x="0" y="0" layer="BACKGROUND"/>
    <!-- the name, drawn twice a pixel apart (bold) -->
    <bold key="name" x="0" baseline="17" colour="TEXT"/>
    <on script="OnUpdate" call="Update"/>
    <do Hide=""/>
  </frame>
</ui>
