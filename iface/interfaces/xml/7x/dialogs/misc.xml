<!-- 7.x's look of the music dialog and the paper (its XML twin's layout; misc.lua draws with it), 4a's own windows.
     Format: core/xml.md; each dialog's attributes are its look entry's values (interfaces/xml/entry.lua), its children where
     misc.lua draws its parts: rectangles (left, top, right, bottom), pictures (file, palette) and image buttons
     (BUTT001.EPF's image id first).
     WIRE: a control's rectangle is where a press on it lands (the controls, their indexes, the keys and what is sent are
     the renderer's and the model's); changing one changes which control a press reaches. -->
<ui>
  <!-- The music dialog (MusicControlDialog::MusicControlDialog 0x00528E60, MusicControlDialog.cpp:23-120): 407 x 410 at
       its slot 3 (centred), DLGSCNTL.EPF in PFLOOK.PAL as its picture; the effects radio (1) of two 45 x 11 options
       (on, off), the frequency radio (3) of three, drawn as 4a's radios; Browse (7, image 50); the silent transport
       (11-13, images 46, 48/37 for pause, 47), 63 x 24; OK (14, image 14). The shared inputs (s6-ui-core r66, X8) on 4a's
       rectangles: the two volume sliders (2 effects, 4 music: 192 x 13), the music source (5), the folder (6), the CD
       drive's button (8), the order and the repeat (9, 10). -->
  <data key="Music" width="407" height="410" button="63" buttonHeight="11" switch="45" frequency="45" play="63">
    <data key="art" value="DLGSCNTL.EPF, PFLOOK.PAL"/>
    <data key="effects">
      <option rect="52, 77, 97, 88"/>
      <option rect="200, 77, 245, 88"/>
    </data>
    <data key="frequencies">
      <option rect="51, 139, 96, 150"/>
      <option rect="124, 139, 169, 150"/>
      <option rect="192, 139, 237, 150"/>
    </data>
    <data key="browse" value="50, 205, 205, 268, 229"/>
    <data key="prev" value="46, 36, 305, 99, 329"/>
    <data key="pause" value="110, 305, 173, 329"/>
    <data key="pauseImages" playing="48" paused="37"/>
    <data key="next" value="47, 184, 305, 247, 329"/>
    <data key="ok" value="14, 110, 360, 173, 384"/>
    <data key="volumes" width="192" height="13">
      <data key="effects" value="51, 92"/>
      <data key="music" value="51, 155"/>
    </data>
    <data key="sources">
      <option rect="30, 182, 140, 193"/>
      <option rect="30, 198, 140, 209"/>
