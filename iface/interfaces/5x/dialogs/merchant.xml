<?xml version="1.0" encoding="utf-8"?>
<!-- 5.x's look of the merchant menus (its XML twin's layout; merchant.lua draws with it), from 5.33's own constructors
     (merchant.lua's header). Every window in NPAL8.PAL; 5.33's image buttons, 72 x 16 (14 OK, 16 TOP, 15 QUIT, 22
     CANCEL, 36 ADD). Format: core/xml.md; each dialog's attributes are its look entry's values (interfaces/original/entry.lua), its
     children where merchant.lua draws its parts: rectangles (left, top, right, bottom), lists (the rectangle and the
     cell's width and height), pictures and image buttons (BUTT001.EPF's image id first).
     WIRE: a control's rectangle is where a press on it lands; changing one changes which control a press reaches. -->
<ui>
  <!-- OK, TOP and QUIT along a row: their images, from its left x 77 apart, 72 x 16 -->
  <data key="BUTTONS" images="14, 16, 15" step="77" width="72" height="16"/>
  <!-- the menus on DLGMERC1 (TextMenuDialog 0x0046E450, the spell menus, ClientItemMenuDialog 0x00470AB0): 314 x 356;
       the buttons from (44, 306); the portrait; the prompt; the list of 228-pixel cells (12 high, the sell menu's 24) -->
  <data key="MERC1" file="DLGMERC1.EPF" width="314" height="356">
    <data key="buttons" value="44, 306"/>
    <data key="portrait" value="35, 37, 72, 92"/>
    <data key="prompt" value="122, 37, 266, 133"/>
    <data key="list" value="36, 141, 278, 285, 228"/>
  </data>
  <!-- the menus on DLGMERC3 (ServerItemMenuDialog 0x0046FE60; the goods): 434 x 371; the buttons from (104, 281); the
       portrait; the prompt; the list of 348 x 24 cells; the description line -->
  <data key="MERC3" file="DLGMERC3.EPF" width="434" height="371">
    <data key="buttons" value="104, 281"/>
    <data key="portrait" value="35, 37, 72, 92"/>
    <data key="prompt" value="83, 30, 383, 130"/>
    <data key="list" value="36, 140, 398, 260, 348, 24"/>
    <data key="description" value="50, 310, 384, 322"/>
  </data>

  <!-- the text menu: 12-pixel rows -->
  <data key="TextMenu" width="314" height="356" button="72" listWidth="228" listHeight="144">
    <data key="list" rows="12"/>
  </data>
  <!-- the sell menu: 24-pixel rows, the picture centred on x 12, the name from 50 fitted to 178 -->
  <data key="SellMenu" width="314" height="356" button="72" listWidth="228" listHeight="144">
    <data key="list" rows="24"/>
    <data key="row" value="12, 50, 178"/>
  </data>
  <!-- the server's items: the picture on x 12, the name in 50-270 fitted to 220, "%10u" from the cell's right - 62
       (0x004708F0) -->
  <data key="ItemMenu" width="434" height="371" button="72" listWidth="348" listHeight="120">
    <data key="row" value="12, 50, 220"/>
    <data key="price" value="348, 62"/>
  </data>
  <!-- the goods: the name in 50-200, the count ending at 270, the price ending at the price box's right, 346 -->
  <data key="GoodsMenu" width="434" height="371" button="72" listWidth="348" listHeight="120">
    <data key="row" value="12, 50, 150"/>
    <data key="ends" count="270" price="346"/>
  </data>
  <!-- the text input (TextInputMenuDialog 0x0046F710): 314 x 197 on DLGMERC2; the buttons from (44, 147); the portrait;
       the prompt; the edit in 0x80 -->
  <data key="MerchantInput" width="314" height="197" button="72" editWidth="201" editHeight="12">
    <data key="art" value="DLGMERC2.EPF, NPAL8.PAL"/>
    <data key="buttons" value="44, 147"/>
    <data key="portrait" value="35, 37, 72, 92"/>
    <data key="prompt" value="82, 35, 262, 83"/>
    <data key="edit" value="56, 113, 257, 125"/>
  </data>
  <!-- the windows on DLGEXC3 (AddItemWithCountDialog 0x0042D150, NumberInputDialog 0x0047CDD0): 287 x 277; the first
       button (ADD 36 for the trade's count, else OK 14), CANCEL 22; the text; the edit in 0x80 -->
  <data key="Input" width="287" height="277" button="72" editWidth="182" editHeight="12">
    <data key="art" value="DLGEXC3.EPF, NPAL8.PAL"/>
    <data key="cancel" value="22, 146, 225, 218, 241"/>
    <data key="edit" value="52, 129, 234, 141"/>
    <data key="first" value="69, 225, 141, 241"/>
    <data key="images" count="36" ok="14"/>
    <data key="text" value="37, 36, 249, 119"/>
  </data>
</ui>
